<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.transcript-analyzer</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <!-- Update this path to match where you cloned the repo -->
        <string>/Users/YOUR_USERNAME/code/transcript-analyzer/bin/analyze.sh</string>
    </array>

    <!-- Run every 30 minutes. Increase to 3600 (hourly) if 30 min feels chatty. -->
    <key>StartInterval</key>
    <integer>1800</integer>

    <!-- Don't pile up runs if the laptop wakes after a long sleep. -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <!-- Update this path to match your username -->
    <string>/Users/YOUR_USERNAME/Library/Logs/transcript-analyzer-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR_USERNAME/Library/Logs/transcript-analyzer-launchd.log</string>

    <!-- Inherit a minimal PATH so /usr/bin (osascript) AND the `claude` CLI are
         available. launchd's PATH does not include your shell's additions, so the
         Claude Code install dir must be listed here (run `dirname "$(which claude)"`
         to find it — often ~/.claude/local or /opt/homebrew/bin). The claude-cli
         backend will fail closed with a clear "claude CLI not found" error if it
         isn't reachable. Alternatively set CLAUDE_BIN to an absolute path below. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin</string>
        <!-- Absolute path to the Claude Code binary (most robust under launchd).
             Find yours with: which claude -->
        <key>CLAUDE_BIN</key>
        <string>/opt/homebrew/bin/claude</string>
    </dict>
</dict>
</plist>
