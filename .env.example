# === Execution backend =====================================================
# claude-cli : run analysis through the Claude Code CLI (`claude -p`) using a
#              Claude Code seat — bills to the seat, NOT to ANTHROPIC_API_KEY.
#              This is the default. Requires the `claude` binary (see CLAUDE_BIN).
# api        : legacy direct Anthropic API path. Requires ANTHROPIC_API_KEY.
BACKEND=claude-cli

# Path to the Claude Code binary. Default "claude" resolves on PATH for
# interactive shells, but launchd has a minimal PATH — set an ABSOLUTE path here
# for scheduled runs (find it with `which claude` on the target machine).
# CLAUDE_BIN=/usr/local/bin/claude

# Extra args appended to every `claude -p` call — used to disable tools so the
# run is pure text generation. Flag names vary by CLI version; override if the
# default errors on your version (e.g. --disallowedTools "Bash Edit Write ...").
# CLAUDE_EXTRA_ARGS=--allowed-tools ""

# Anthropic API key — required ONLY when BACKEND=api. Leave blank for claude-cli.
ANTHROPIC_API_KEY=

# === Routing (claude-cli backend) ==========================================
# Model used to classify each transcript into DAILY/STANDUP/SOLUTION/EXEC.
# Default is the (dated) Haiku id confirmed on the work seat. Override only if a
# different seat exposes different ids (find them with bin/phase0_check.sh).
# CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# Per-category analysis models (defaults baked into config.py, all confirmed on
# the work seat). EXEC/SOLUTION on Opus, the rest on Sonnet. Override if needed:
# MODEL_DAILY=claude-sonnet-4-6
# MODEL_STANDUP=claude-sonnet-4-6
# MODEL_SOLUTION=claude-opus-4-7
# MODEL_EXEC=claude-opus-4-7

# === Shareable redaction pass ==============================================
# Emit a [SHAREABLE] sibling (internal politics / career notes stripped) for each
# analysis. Set false to skip. Tune the prompt via a `### REDACT.` block in
# PromptLibrary.md (a built-in default is used if absent).
# SHAREABLE_PASS=true
# REDACTION_MODEL=claude-sonnet-4-6

# Paths (defaults assume macOS Drive for Desktop layout under brad@bradgross.org)
# CALL_TRANSCRIPTS_PATH=~/Library/CloudStorage/GoogleDrive-brad@bradgross.org/My Drive/Workcall/Call Transcripts
# PROCESSED_PATH=~/Library/CloudStorage/GoogleDrive-brad@bradgross.org/My Drive/Workcall/Call Transcripts/_Processed
# ANALYZED_PATH=~/Library/CloudStorage/GoogleDrive-brad@bradgross.org/My Drive/Workcall/Analyzed
# PROMPT_LIBRARY_PATH=~/Library/CloudStorage/GoogleDrive-brad@bradgross.org/My Drive/Workcall/PromptLibrary.md
# CONTEXT_BRIEF_PATH=~/Library/CloudStorage/GoogleDrive-brad@bradgross.org/My Drive/Workcall/Program_Context_Brief.md

# Default/fallback prompt key. Used as the single prompt for BACKEND=api, and as
# the last-resort fallback for claude-cli when a routed category prompt is absent.
DEFAULT_PROMPT_KEY=A2

# Per-prompt model defaults (overridable)
# MODEL_A1=claude-opus-4-7
# MODEL_A2=claude-sonnet-4-6
# MODEL_A3=claude-sonnet-4-6
# MODEL_B1=claude-sonnet-4-6
# MODEL_B2=claude-opus-4-7
# MODEL_B3=claude-sonnet-4-6
# MODEL_B4=claude-opus-4-7

# One-off override that wins over per-prompt defaults for this run
# MODEL_OVERRIDE=claude-opus-4-7

# Effort: low | medium | high | max  (max is Opus-only)
EFFORT=high
